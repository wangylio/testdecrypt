# 设备点检保养域工具定义（2026-08-20 新增）
#
# 点检保养是一组概念："点检 = 保养"同义（口语"日点检"=标准"日保养"），不区分单类型。
# - 记录：点检单表 BASIC.MesCheckList —— 点检保养单据须按模板类型区分：本工具只返回其关联
#   BASIC.MESCHECKLISTTEMPLATE（经 checklisttemplateid = id 关联）templatetype =
#   'MesCheckListTask_EquipMent' 的点检保养单据；与维修记录同构走 template（需跨表过滤，
#   declarative 单表引擎无法表达），设备编号经根表 MBSEQUIPMENT CODE 子查询定位 equipmentid，
#   以 planstartdate 计划开始时间为时间基准，回答"这台设备的保养记录 / 这个月的保养"。
# - 策略：点检任务表 BASIC.MesCheckListTask 本身无设备列，设备靠桥表
#   BASIC.MesCheckListTaskEquipment 组合，需跨两表取列，故走 template（与维修记录同构），
#   经桥表 equipmentid 定位设备，回答"这台设备的保养计划 / 周期 / 日周月安排"。
# - 点检单模板（checklisttemplateid）本期保持原始 id 输出，模板查询功能留作后续扩展。
# - 状态/结果/周期类型等枚举经 translate_columns 走 cboitems 统一编码体系翻译中文名
#   （子类型名按 CBOITEMS 真实 code 核对，见 resources/codelists.yaml）。
# - 表名须带 BASIC. 前缀（只读账号访问）。

- name: device_checklist_record
  description: 按设备编号查询该设备的点检保养记录（单据编号、点检单模板id、点检单状态、点检结果、计划/实际执行时间、操作人、提交日期、备注等），按计划开始时间倒序，最多 20 条。仅返回模板类型为点检保养（MesCheckListTask_EquipMent）的记录。用于回答"某台设备的点检保养记录/点检单/这个月的保养"等记录类问题（可附带时间范围，按计划开始时间过滤）。需先经 query_device_list 取得唯一设备编号后调用。
  mode: template
  db: mes
  sql: |
    SELECT c.docno AS 单据编号,
           c.checklisttemplateid AS 点检单模板,
           c.checkliststate AS 点检单状态,
           c.result AS 点检结果,
           c.planstartdate AS 计划开始,
           c.planenddate AS 计划结束,
           c.realstartdate AS 实际开始,
           c.realenddate AS 实际结束,
           c.CREATEUSER AS 操作人,
           c.submitdate AS 提交日期,
           c.description AS 备注
    FROM BASIC.MesCheckList c
    JOIN BASIC.MesChecklistTemplate t ON t.id = c.checklisttemplateid
    WHERE c.enabled = 1
      AND t.enabled = 1
      AND t.templatetype = 'MesCheckListTask_EquipMent'
      AND c.equipmentid = (SELECT id FROM BASIC.MBSEQUIPMENT WHERE CODE = :device_code)
      AND (:date_from IS NULL OR c.planstartdate >= TO_DATE(:date_from, 'YYYY-MM-DD'))
      AND (:date_to IS NULL OR c.planstartdate < TO_DATE(:date_to, 'YYYY-MM-DD') + 1)
    ORDER BY c.planstartdate DESC
  translate_columns:
    点检单状态: CboItems.MesCheckListInstanceState
    点检结果: CboItems.MesCheckListInstanceResult
    操作人: CboUser
  params:
    - name: device_code
      type: string
      description: 设备编号（必填，来自 query_device_list 的唯一设备编号）
      required: true
    - name: date_from
      type: date
      description: 起始日期（可选，YYYY-MM-DD 或 last_1d/1w/1m/1y，不填则不限制）
    - name: date_to
      type: date
      description: 结束日期（可选，YYYY-MM-DD 或 last_1d/1w/1m/1y，不填则不限制）
  limit: 20

- name: device_checklist_task
  description: 按设备编号查询该设备的点检保养策略/周期（任务编码、任务名称、周期类型[日/周/月]、周期频率、第几周、第几天、持续时间[小时]、开始时间、任务状态、备注等），按周期类型与开始时间排序，最多 20 条。用于回答"某台设备的点检保养计划/策略/周期/日周月保养安排"等策略类问题，可按周期类型、任务状态附加过滤。需先经 query_device_list 取得唯一设备编号后调用。
  mode: template
  db: mes
  sql: |
    SELECT t.code AS 任务编码,
           t.name AS 任务名称,
           t.periodtype AS 周期类型,
           t.periodfrequency AS 周期频率,
           t.weeksequence AS 第几周,
           t.daysequence AS 第几天,
           t.duration AS 持续时间小时,
           t.begintime AS 开始时间,
           t.taskstate AS 任务状态,
           t.description AS 备注
    FROM BASIC.MesCheckListTask t
    JOIN BASIC.MesCheckListTaskEquipment e ON e.checklisttaskid = t.id
    WHERE t.enabled = 1
      AND e.enabled = 1
      AND e.equipmentid = (SELECT id FROM BASIC.MBSEQUIPMENT WHERE CODE = :device_code)
      AND (:period_type IS NULL OR t.periodtype = :period_type)
      AND (:task_state IS NULL OR t.taskstate = :task_state)
    ORDER BY t.periodtype, t.begintime
  translate_columns:
    周期类型: CboItems.MesCheckListTaskPeriodType
    任务状态: CboItems.MesCheckListTaskState
  params:
    - name: device_code
      type: string
      description: 设备编号（必填，来自 query_device_list 的唯一设备编号）
      required: true
    - name: period_type
      type: string
      description: 周期类型（可选，如日/周/月，不填则不限制）
    - name: task_state
      type: string
      description: 任务状态（可选，不填则不限制）
  limit: 20

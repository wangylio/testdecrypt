"""http 能力包：外部 HTTP 服务调用这一项完整、自治的能力。

整合定义（defs.py）、请求组装与执行（executor.py）、后端连接（backend.py）、
Agent 工具注册（registry.py）为一体。对外契约（供 definitions / main 装配）：

- `build_tools(defs_dir)` → 把目录下的 YAML 工具定义构建为 `StructuredTool` 列表
- `register_all_endpoints()` / `close_endpoints()` → 平台生命周期：加载 `resources/endpoints.yaml`、释放 HTTP 客户端

注意：`app.core.http`（client.py）是纯驱动（异步客户端/认证/协议，无工具与 Agent 概念），
本包是能力层——两层同名不同层，import 时勿混。相对时间换算等纯工具函数上提到
`app/harness/tools/_time.py` 共享，能力包之间零依赖。
"""
from __future__ import annotations

from pathlib import Path

from app.harness.tools.http.backend import close_endpoints, register_all_endpoints
from app.harness.tools.http.defs import HttpToolDef, HttpParamSpec, load_tool_defs
from app.harness.tools.http.registry import make_agent_tool


def build_tools(defs_dir: Path) -> list:
    """把指定目录的 YAML 工具定义构建为 Agent 可调用的 StructuredTool 列表。"""
    defs = load_tool_defs(defs_dir)
    return [make_agent_tool(d) for d in defs]


__all__ = [
    # 对外契约
    "build_tools",
    "register_all_endpoints",
    "close_endpoints",
    # 定义模型
    "HttpToolDef",
    "HttpParamSpec",
    "load_tool_defs",
    # 注册
    "make_agent_tool",
]
"""会话管理：短期对话记忆的创建、续接、删除与列举。

自管 SQLite 单表快照持久化，承载所有 Agent 的所有会话；不依赖任何 Agent
框架的会话组件。session_id 格式 `{agent}-{uuid}`，以 agent 前缀命名空间隔离，
防止上下文跨 Agent 污染。每个会话一行存整条对话消息 JSON（LangChain 消息
message_to_dict/messages_from_dict 序列化），每次请求快照覆盖；系统提示词
由执行层注入，不落库。

约定：Agent 名不含分隔符 `-`，否则前缀解析失效（注册表当前均为短名，符合约定）。
每次读写独立开连接、用后即关，不缓存连接句柄（防文件锁泄漏）。
"""
from __future__ import annotations

import asyncio
import json
import sqlite3
from pathlib import Path
from uuid import uuid4

from langchain_core.messages import BaseMessage, HumanMessage, message_to_dict, messages_from_dict

from app.core.config.settings import _PROJECT_ROOT

# 会话数据文件：工程根 data/ 目录下
_DATA_DIR = _PROJECT_ROOT / "data"
_DEFAULT_DB_PATH = _DATA_DIR / "sessions.db"

# session_id 前缀分隔符，也是 Agent 归属的编码方式
AGENT_SEP = "-"

# 会话快照表 DDL：一会话一行，messages 存整条对话消息 JSON
_DDL = """
CREATE TABLE IF NOT EXISTS sessions (
    session_id  TEXT PRIMARY KEY,
    agent       TEXT NOT NULL,
    messages    TEXT NOT NULL,
    created_at  TEXT NOT NULL,
    updated_at  TEXT NOT NULL
)
"""


class SessionNotFoundError(Exception):
    """会话不存在。"""


class SessionNotBelongError(Exception):
    """会话归属的 Agent 与请求 Agent 不一致。"""


def _trim_history(messages: list[BaseMessage], round_limit: int | None) -> list[BaseMessage]:
    """按「轮」裁剪历史：保留最近 round_limit 个完整回合（读时截断，不物理删）。

    每轮以 HumanMessage 为界：一个用户回合 = 用户消息 + 其后的全部 AI 工具调用 /
    ToolMessage / 最终回复。整轮裁剪保证 AI tool_call 与其 ToolMessage 的配对完整，
    不被砍半（裁到半轮会造成悬空工具调用/缺失的结果，模型续接时易出错）。
    """
    if round_limit is None:
        return messages
    starts = [i for i, m in enumerate(messages) if isinstance(m, HumanMessage)]
    if len(starts) <= round_limit:
        return messages
    return messages[starts[-round_limit]:]


def _escape_like(value: str) -> str:
    """转义 SQLite LIKE 通配符，避免 Agent 名中的 %/_ 干扰前缀匹配。"""
    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")


class Conversation:
    """一个会话的读写句柄：读历史 / 快照写回，每次操作独立开连接。

    携带 per-session asyncio.Lock：同会话的「读→执行→写回」由 SessionManager
    提供锁串行化，防并发丢回合。无 close()——无文件句柄需释放。
    """

    def __init__(self, db_path: Path, session_id: str, agent: str, lock: asyncio.Lock) -> None:
        self._db_path = Path(db_path)
        self.session_id = session_id
        self._agent = agent
        self.lock = lock

    async def load(self, round_limit: int | None = None) -> list[BaseMessage]:
        """读该会话历史（按 round_limit 截取最近 N 轮）；无记录返回空列表。"""
        payload = await asyncio.to_thread(self._load_payload)
        if payload is None:
            return []
        messages = messages_from_dict(json.loads(payload))
        return _trim_history(messages, round_limit)

    async def save(self, messages: list[BaseMessage]) -> None:
        """把本轮完整消息列表快照写回（会话不存在则新建行）。"""
        payload = json.dumps([message_to_dict(m) for m in messages], ensure_ascii=False)
        await asyncio.to_thread(self._save_payload, payload)

    # ---- 同步 SQLite 读写（经 asyncio.to_thread 执行）----

    def _load_payload(self) -> str | None:
        if not self._db_path.exists():
            return None
        with self._connect() as conn:
            row = conn.execute(
                "SELECT messages FROM sessions WHERE session_id = ?", (self.session_id,)
            ).fetchone()
        return row[0] if row else None

    def _save_payload(self, payload: str) -> None:
        with self._connect() as conn:
            conn.execute(
                "INSERT INTO sessions (session_id, agent, messages, created_at, updated_at) "
                "VALUES (?, ?, ?, datetime('now'), datetime('now')) "
                "ON CONFLICT(session_id) DO UPDATE SET "
                "messages = excluded.messages, updated_at = datetime('now')",
                (self.session_id, self._agent, payload),
            )
            conn.commit()

    def _connect(self) -> sqlite3.Connection:
        """建目录 + 建表 + 打开独立连接（每次操作独立开、用后即关）。"""
        self._db_path.parent.mkdir(parents=True, exist_ok=True)
        conn = sqlite3.connect(self._db_path)
        conn.execute(_DDL)
        return conn


class SessionManager:
    """短期会话的创建/续接/删除/列举。

    「文件即状态」：每次请求按需构造 Conversation、用后即弃，不缓存连接句柄。
    per-session 锁防同会话并发「后写覆盖先写」丢回合；锁随会话删除移除。
    """

    def __init__(self, db_path: Path = _DEFAULT_DB_PATH) -> None:
        self._db_path = Path(db_path)
        self._locks: dict[str, asyncio.Lock] = {}

    # ---- 对外接口 ----

    def get(self, agent: str, session_id: str | None = None) -> tuple[str, Conversation]:
        """创建新会话或续接既有会话，返回 (session_id, conversation)。

        无 session_id → 生成 `{agent}-{uuid}` 新会话；
        有 → 校验 agent 前缀一致且会话存在，否则抛
        SessionNotBelongError / SessionNotFoundError。历史读写在 conversation 上完成。
        """
        if session_id is None:
            session_id = self._make_session_id(agent)
            return session_id, self._build_conversation(session_id, agent)

        if self._parse_agent(session_id) != agent:
            raise SessionNotBelongError(
                f"session_id '{session_id}' 归属 Agent 与请求 Agent '{agent}' 不一致"
            )
        if not self._session_exists(session_id):
            raise SessionNotFoundError(f"session_id '{session_id}' 不存在")
        return session_id, self._build_conversation(session_id, agent)

    async def delete(self, session_id: str) -> None:
        """删除会话（快照方式仅删一行）。幂等：db 不存在/会话不存在时静默返回。"""
        await asyncio.to_thread(self._delete_row, session_id)
        self._locks.pop(session_id, None)

    async def list_sessions(self, agent: str | None = None) -> list[dict[str, str]]:
        """按可选 Agent 前缀过滤，返回会话元数据（不含消息内容）。"""
        if not self._db_path.exists():
            return []

        def _query() -> list[dict[str, str]]:
            with sqlite3.connect(self._db_path) as conn:
                if agent is None:
                    rows = conn.execute(
                        "SELECT session_id, created_at, updated_at FROM sessions "
                        "ORDER BY updated_at DESC"
                    ).fetchall()
                else:
                    rows = conn.execute(
                        f"SELECT session_id, created_at, updated_at FROM sessions "
                        f"WHERE session_id LIKE ? ESCAPE '\\' ORDER BY updated_at DESC",
                        (f"{_escape_like(agent)}{AGENT_SEP}%",),
                    ).fetchall()
            return [
                {"session_id": sid, "created_at": created, "updated_at": updated}
                for sid, created, updated in rows
            ]

        return await asyncio.to_thread(_query)

    async def delete_agent_sessions(self, agent: str) -> int:
        """删除某 Agent 名下全部会话，返回删除数。"""
        if not self._db_path.exists():
            return 0

        def _delete() -> int:
            with self._connect() as conn:
                cur = conn.execute(
                    "DELETE FROM sessions WHERE session_id LIKE ? ESCAPE '\\'",
                    (f"{_escape_like(agent)}{AGENT_SEP}%",),
                )
                conn.commit()
                return cur.rowcount

        return await asyncio.to_thread(_delete)

    # ---- 内部实现 ----

    def _make_session_id(self, agent: str) -> str:
        """生成 `{agent}-{uuid}` 形式的新会话 id。"""
        return f"{agent}{AGENT_SEP}{uuid4()}"

    def _parse_agent(self, session_id: str) -> str:
        """解析 session_id 的 agent 前缀（第一个分隔符之前的部分）。"""
        return session_id.split(AGENT_SEP, 1)[0]

    def _build_conversation(self, session_id: str, agent: str) -> Conversation:
        """构造会话句柄（锁按 session_id 复用，防同会话并发丢回合）。"""
        lock = self._locks.get(session_id)
        if lock is None:
            lock = self._locks[session_id] = asyncio.Lock()
        return Conversation(self._db_path, session_id, agent, lock)

    def _session_exists(self, session_id: str) -> bool:
        """会话行是否已存在。db 不存在/查错一律视为不存在。"""
        if not self._db_path.exists():
            return False
        try:
            with sqlite3.connect(self._db_path) as conn:
                row = conn.execute(
                    "SELECT 1 FROM sessions WHERE session_id = ?", (session_id,)
                ).fetchone()
            return row is not None
        except sqlite3.Error:
            return False

    def _delete_row(self, session_id: str) -> None:
        """删除单个会话行（幂等：不存在即无操作）。"""
        if not self._db_path.exists():
            return
        with self._connect() as conn:
            conn.execute("DELETE FROM sessions WHERE session_id = ?", (session_id,))
            conn.commit()

    def _connect(self) -> sqlite3.Connection:
        """建目录 + 建表 + 打开独立连接（与 Conversation 同款）。"""
        self._db_path.parent.mkdir(parents=True, exist_ok=True)
        conn = sqlite3.connect(self._db_path)
        conn.execute(_DDL)
        return conn


# 模块级单例，供 API 层引用
session_manager = SessionManager()
from typing import Any

from sqlalchemy import delete, select, update
from sqlalchemy.ext.asyncio import AsyncSession

from common.vo import PageModel
from module_agent.entity.do.termbase_do import ZclawTermbase
from module_agent.entity.vo.termbase_vo import TermbaseModel, TermbasePageQueryModel
from utils.page_util import PageUtil


class TermbaseDao:
    """
    术语表数据库操作层（PG 向量数据源会话）

    术语内容服务于 jieba 分词器用户词典注入（向量化与keywords检索两侧同源）。
    """

    @classmethod
    async def query_by_id(cls, db: AsyncSession, term_id: int) -> ZclawTermbase | None:
        """
        根据术语主键获取术语信息

        :param db: orm对象（PG向量源会话）
        :param term_id: 术语主键
        :return: 术语信息对象
        """
        return (await db.execute(select(ZclawTermbase).where(ZclawTermbase.term_id == term_id))).scalars().first()

    @classmethod
    async def query_by_content(
        cls, db: AsyncSession, kb_id: int, content: str, exclude_id: int | None = None
    ) -> ZclawTermbase | None:
        """
        根据知识库+术语内容查询（用于去重校验）

        :param db: orm对象（PG向量源会话）
        :param kb_id: 知识库主键
        :param content: 术语内容
        :param exclude_id: 排除的术语主键（编辑场景）
        :return: 术语信息对象
        """
        query = select(ZclawTermbase).where(ZclawTermbase.kb_id == kb_id, ZclawTermbase.content == content)
        if exclude_id:
            query = query.where(ZclawTermbase.term_id != exclude_id)

        return (await db.execute(query)).scalars().first()

    @classmethod
    async def query_list(
        cls, db: AsyncSession, query_object: TermbasePageQueryModel, is_page: bool = True
    ) -> PageModel | list[dict[str, Any]]:
        """
        根据查询参数获取术语列表信息

        :param db: orm对象（PG向量源会话）
        :param query_object: 查询参数对象
        :param is_page: 是否开启分页
        :return: 术语列表信息对象
        """
        query = (
            select(ZclawTermbase)
            .where(
                ZclawTermbase.kb_id == query_object.kb_id if query_object.kb_id else True,
                ZclawTermbase.content.like(f'%{query_object.content}%') if query_object.content else True,
            )
            .order_by(ZclawTermbase.term_id.asc())
        )

        return await PageUtil.paginate(db, query, query_object.page_num, query_object.page_size, is_page)

    @classmethod
    async def query_contents_by_kb(cls, db: AsyncSession, kb_id: int) -> list[str]:
        """
        查询知识库全部术语内容（jieba 分词器用户词典注入）

        :param db: orm对象（PG向量源会话）
        :param kb_id: 知识库主键
        :return: 术语内容列表
        """
        query = select(ZclawTermbase.content).where(ZclawTermbase.kb_id == kb_id).order_by(ZclawTermbase.term_id.asc())

        return list((await db.execute(query)).scalars().all())

    @classmethod
    async def insert(cls, db: AsyncSession, data: TermbaseModel) -> ZclawTermbase:
        """
        新增术语数据库操作

        :param db: orm对象（PG向量源会话）
        :param data: 术语对象
        :return: 术语信息对象
        """
        db_obj = ZclawTermbase(**data.model_dump(exclude_unset=True, exclude={'create_time', 'update_time'}))
        db.add(db_obj)
        await db.flush()

        return db_obj

    @classmethod
    async def update(cls, db: AsyncSession, data: dict) -> None:
        """
        更新术语数据库操作

        :param db: orm对象（PG向量源会话）
        :param data: 需要更新的术语字典（必须携带term_id）
        :return: None
        """
        update_values = {
            key: value for key, value in data.items() if key not in {'create_time', 'update_time', 'create_by'}
        }
        term_id = update_values.pop('term_id')
        await db.execute(update(ZclawTermbase).where(ZclawTermbase.term_id == term_id).values(**update_values))

    @classmethod
    async def delete(cls, db: AsyncSession, term_id: int) -> None:
        """
        删除术语数据库操作

        :param db: orm对象（PG向量源会话）
        :param term_id: 术语主键
        :return: None
        """
        await db.execute(delete(ZclawTermbase).where(ZclawTermbase.term_id == term_id))

    @classmethod
    async def delete_list(cls, db: AsyncSession, term_ids: list[int]) -> None:
        """
        批量删除术语数据库操作

        :param db: orm对象（PG向量源会话）
        :param term_ids: 术语主键列表
        :return: None
        """
        if not term_ids:
            return
        await db.execute(delete(ZclawTermbase).where(ZclawTermbase.term_id.in_(term_ids)))

    @classmethod
    async def delete_by_kb(cls, db: AsyncSession, kb_id: int) -> None:
        """
        按知识库物理删除术语（知识库删除级联）

        :param db: orm对象（PG向量源会话）
        :param kb_id: 知识库主键
        :return: None
        """
        await db.execute(delete(ZclawTermbase).where(ZclawTermbase.kb_id == kb_id))

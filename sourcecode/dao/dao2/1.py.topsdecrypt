from typing import Any

from sqlalchemy import delete, select, update
from sqlalchemy.ext.asyncio import AsyncSession

from common.vo import PageModel
from module_agent.entity.do.problem_do import ZclawProblem
from module_agent.entity.do.problem_paragraph_do import ZclawProblemParagraph
from module_agent.entity.vo.problem_vo import ProblemModel, ProblemPageQueryModel
from utils.page_util import PageUtil


class ProblemDao:
    """
    关联问题（FAQ）数据库操作层（含问题-段落关联）

    注意：zclaw_problem_paragraph.paragraph_id 为跨数据源逻辑引用（指向 PG 侧段落），
    映射写入/清理均走 MySQL 主库会话。
    """

    @classmethod
    async def query_by_id(cls, db: AsyncSession, problem_id: int) -> ZclawProblem | None:
        """
        根据问题主键获取问题信息

        :param db: orm对象
        :param problem_id: 问题主键
        :return: 问题信息对象
        """
        return (await db.execute(select(ZclawProblem).where(ZclawProblem.problem_id == problem_id))).scalars().first()

    @classmethod
    async def query_by_content(
        cls, db: AsyncSession, kb_id: int, content: str, exclude_id: int | None = None
    ) -> ZclawProblem | None:
        """
        根据知识库+问题正文查询问题（用于去重校验）

        :param db: orm对象
        :param kb_id: 知识库主键
        :param content: 问题正文
        :param exclude_id: 排除的问题主键（编辑场景）
        :return: 问题信息对象
        """
        query = select(ZclawProblem).where(ZclawProblem.kb_id == kb_id, ZclawProblem.content == content)
        if exclude_id:
            query = query.where(ZclawProblem.problem_id != exclude_id)

        return (await db.execute(query)).scalars().first()

    @classmethod
    async def query_list(
        cls, db: AsyncSession, query_object: ProblemPageQueryModel, is_page: bool = True
    ) -> PageModel | list[dict[str, Any]]:
        """
        根据查询参数获取问题列表信息

        :param db: orm对象
        :param query_object: 查询参数对象
        :param is_page: 是否开启分页
        :return: 问题列表信息对象
        """
        query = (
            select(ZclawProblem)
            .where(
                ZclawProblem.kb_id == query_object.kb_id if query_object.kb_id else True,
                ZclawProblem.content.like(f'%{query_object.content}%') if query_object.content else True,
            )
            .order_by(ZclawProblem.create_time.desc(), ZclawProblem.problem_id.desc())
        )

        return await PageUtil.paginate(db, query, query_object.page_num, query_object.page_size, is_page)

    @classmethod
    async def insert(cls, db: AsyncSession, data: ProblemModel) -> ZclawProblem:
        """
        新增问题数据库操作

        :param db: orm对象
        :param data: 问题对象
        :return: 问题信息对象
        """
        db_obj = ZclawProblem(**data.model_dump(exclude_unset=True, exclude={'create_time', 'update_time', 'paragraph_ids'}))
        db.add(db_obj)
        await db.flush()

        return db_obj

    @classmethod
    async def update(cls, db: AsyncSession, data: dict) -> None:
        """
        更新问题数据库操作

        :param db: orm对象
        :param data: 需要更新的问题字典（必须携带problem_id）
        :return: None
        """
        update_values = {
            key: value
            for key, value in data.items()
            if key not in {'create_time', 'update_time', 'create_by', 'paragraph_ids'}
        }
        problem_id = update_values.pop('problem_id')
        await db.execute(update(ZclawProblem).where(ZclawProblem.problem_id == problem_id).values(**update_values))

    @classmethod
    async def delete(cls, db: AsyncSession, problem_id: int) -> None:
        """
        删除问题数据库操作（关联解除由服务层先编排）

        :param db: orm对象
        :param problem_id: 问题主键
        :return: None
        """
        await db.execute(delete(ZclawProblem).where(ZclawProblem.problem_id == problem_id))

    @classmethod
    async def delete_list(cls, db: AsyncSession, problem_ids: list[int]) -> None:
        """
        批量删除问题数据库操作

        :param db: orm对象
        :param problem_ids: 问题主键列表
        :return: None
        """
        if not problem_ids:
            return
        await db.execute(delete(ZclawProblem).where(ZclawProblem.problem_id.in_(problem_ids)))

    @classmethod
    async def query_paragraph_ids(cls, db: AsyncSession, problem_id: int) -> list[int]:
        """
        查询问题关联的段落主键列表

        :param db: orm对象
        :param problem_id: 问题主键
        :return: 段落主键列表
        """
        query = select(ZclawProblemParagraph.paragraph_id).where(ZclawProblemParagraph.problem_id == problem_id)

        return list((await db.execute(query)).scalars().all())

    @classmethod
    async def query_problem_ids_by_paragraph(cls, db: AsyncSession, paragraph_id: int) -> list[int]:
        """
        查询段落关联的问题主键列表（段落详情展示用）

        :param db: orm对象
        :param paragraph_id: 段落主键
        :return: 问题主键列表
        """
        query = select(ZclawProblemParagraph.problem_id).where(ZclawProblemParagraph.paragraph_id == paragraph_id)

        return list((await db.execute(query)).scalars().all())

    @classmethod
    async def query_mappings_by_problem(cls, db: AsyncSession, problem_id: int) -> list[ZclawProblemParagraph]:
        """
        查询问题的完整关联记录（含 kb_id/doc_id 冗余列，向量负载重建用）

        :param db: orm对象
        :param problem_id: 问题主键
        :return: 关联记录列表
        """
        query = select(ZclawProblemParagraph).where(ZclawProblemParagraph.problem_id == problem_id)

        return list((await db.execute(query)).scalars().all())

    @classmethod
    async def insert_mappings(cls, db: AsyncSession, items: list[dict]) -> None:
        """
        批量新增问题-段落关联

        :param db: orm对象
        :param items: 关联字典列表（problem_id/paragraph_id/kb_id/doc_id/create_by）
        :return: None
        """
        if not items:
            return
        db.add_all([ZclawProblemParagraph(**item) for item in items])
        await db.flush()

    @classmethod
    async def delete_mappings_by_problem(cls, db: AsyncSession, problem_id: int) -> None:
        """
        删除问题的全部段落关联

        :param db: orm对象
        :param problem_id: 问题主键
        :return: None
        """
        await db.execute(delete(ZclawProblemParagraph).where(ZclawProblemParagraph.problem_id == problem_id))

    @classmethod
    async def delete_mappings_by_paragraphs(cls, db: AsyncSession, paragraph_ids: list[int]) -> None:
        """
        按段落集合删除关联（段落删除/调整联动）

        :param db: orm对象
        :param paragraph_ids: 段落主键列表
        :return: None
        """
        if not paragraph_ids:
            return
        await db.execute(delete(ZclawProblemParagraph).where(ZclawProblemParagraph.paragraph_id.in_(paragraph_ids)))

    @classmethod
    async def delete_mappings_by_doc(cls, db: AsyncSession, doc_id: int) -> None:
        """
        按文档删除关联（文档删除联动）

        :param db: orm对象
        :param doc_id: 文档主键
        :return: None
        """
        await db.execute(delete(ZclawProblemParagraph).where(ZclawProblemParagraph.doc_id == doc_id))

    @classmethod
    async def delete_by_kb(cls, db: AsyncSession, kb_id: int) -> None:
        """
        按知识库删除全部问题（知识库删除级联）

        :param db: orm对象
        :param kb_id: 知识库主键
        :return: None
        """
        await db.execute(delete(ZclawProblem).where(ZclawProblem.kb_id == kb_id))

    @classmethod
    async def delete_mappings_by_kb(cls, db: AsyncSession, kb_id: int) -> None:
        """
        按知识库删除全部问题-段落关联（知识库删除级联）

        :param db: orm对象
        :param kb_id: 知识库主键
        :return: None
        """
        await db.execute(delete(ZclawProblemParagraph).where(ZclawProblemParagraph.kb_id == kb_id))

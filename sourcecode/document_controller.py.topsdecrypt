"""
知识库文档 Controller（上传受理 / 列表 / 详情 / 状态操作 / 删除级联）

路由前缀 /agent/knowledge/document；SSE 由前端轮询列表/详情状态实现（一期）。
"""

from typing import Annotated

from fastapi import File, Form, Path, Query, Request, Response, UploadFile
from sqlalchemy.ext.asyncio import AsyncSession

from common.annotation.cache_annotation import ApiCacheEvict
from common.annotation.log_annotation import Log
from common.aspect.db_session import DBSessionDependency
from common.aspect.interface_auth import UserInterfaceAuthDependency
from common.aspect.pre_auth import CurrentUserDependency, PreAuthDependency
from common.constant import ApiGroup
from common.enums import BusinessType
from common.router import APIRouterPro
from common.vo import DataResponseModel, PageResponseModel
from module_admin.entity.vo.user_vo import CurrentUserModel
from module_agent.entity.vo.document_vo import (
    DocumentBatchDeleteModel,
    DocumentModel,
    DocumentPageQueryModel,
)
from module_agent.service.document_service import DocumentService
from utils.response_util import ResponseUtil

document_controller = APIRouterPro(
    prefix='/agent/knowledge/document',
    order_num=25,
    tags=['知识库管理-文档'],
    dependencies=[PreAuthDependency()],
)


@document_controller.get(
    '/list',
    summary='获取文档分页列表接口',
    description='状态解码标签 + 分段数派生统计；支持 kbId/名称/状态过滤',
    response_model=PageResponseModel[DocumentModel],
    dependencies=[UserInterfaceAuthDependency('agent:knowledge:base:list')],
)
async def document_list(
    request: Request,
    query_object: Annotated[DocumentPageQueryModel, Query()],
    query_db: Annotated[AsyncSession, DBSessionDependency()],
) -> Response:
    result = await DocumentService.list_documents(query_db, query_object)
    return ResponseUtil.success(model_content=result)


@document_controller.post(
    '/upload',
    summary='上传文档接口',
    description='多文件 + ZIP 递归解包；逐文件格式/大小校验；受理后异步解析+分段',
    response_model=DataResponseModel,
    dependencies=[UserInterfaceAuthDependency('agent:knowledge:document:add')],
)
@ApiCacheEvict(namespaces=ApiGroup.KNOWLEDGE_MUTATION)
@Log(title='知识库文档', business_type=BusinessType.INSERT)
async def document_upload(
    request: Request,
    kb_id: Annotated[int, Form(description='知识库主键')],
    files: Annotated[list[UploadFile], File(description='上传文件（多选/ZIP）')],
    query_db: Annotated[AsyncSession, DBSessionDependency()],
    current_user: Annotated[CurrentUserModel, CurrentUserDependency()],
) -> Response:
    uploaded = [(item.filename or 'unnamed', await item.read()) for item in files]
    result = await DocumentService.accept_upload(query_db, kb_id, uploaded, current_user.user_id)
    return ResponseUtil.success(data=result)


@document_controller.get(
    '/{doc_id}',
    summary='获取文档详情接口',
    description='状态解码 + 失败分类原因（前端轮询）',
    response_model=DataResponseModel,
    dependencies=[UserInterfaceAuthDependency('agent:knowledge:base:list')],
)
async def document_detail(
    request: Request,
    doc_id: Annotated[int, Path(description='文档主键')],
    query_db: Annotated[AsyncSession, DBSessionDependency()],
) -> Response:
    result = await DocumentService.get_document(query_db, doc_id)
    return ResponseUtil.success(data=result)


@document_controller.put(
    '/{doc_id}/revectorize',
    summary='确认分段/重新向量化接口',
    description='重置 EMBEDDING 位为待执行并投递向量化任务（分段保留，增量执行）',
    dependencies=[UserInterfaceAuthDependency('agent:knowledge:document:revectorize')],
)
@ApiCacheEvict(namespaces=ApiGroup.KNOWLEDGE_MUTATION)
@Log(title='知识库文档', business_type=BusinessType.UPDATE)
async def document_revectorize(
    request: Request,
    doc_id: Annotated[int, Path(description='文档主键')],
    query_db: Annotated[AsyncSession, DBSessionDependency()],
    current_user: Annotated[CurrentUserModel, CurrentUserDependency()],
) -> Response:
    await DocumentService.reset_for_vectorize(query_db, doc_id, current_user.user_id)
    return ResponseUtil.success()


@document_controller.put(
    '/{doc_id}/cancel',
    summary='取消进行中任务接口',
    description='协作式取消：置 REVOKE 位，任务在检查点退出',
    dependencies=[UserInterfaceAuthDependency('agent:knowledge:document:revectorize')],
)
@ApiCacheEvict(namespaces=ApiGroup.KNOWLEDGE_MUTATION)
@Log(title='知识库文档', business_type=BusinessType.UPDATE)
async def document_cancel(
    request: Request,
    doc_id: Annotated[int, Path(description='文档主键')],
    query_db: Annotated[AsyncSession, DBSessionDependency()],
    current_user: Annotated[CurrentUserModel, CurrentUserDependency()],
) -> Response:
    await DocumentService.cancel_task(query_db, doc_id, current_user.user_id)
    return ResponseUtil.success()


@document_controller.delete(
    '/{doc_id}',
    summary='删除文档接口',
    description='级联清理段落/向量/关联映射/物理文件（幂等可重入）',
    dependencies=[UserInterfaceAuthDependency('agent:knowledge:document:delete')],
)
@ApiCacheEvict(namespaces=ApiGroup.KNOWLEDGE_MUTATION)
@Log(title='知识库文档', business_type=BusinessType.DELETE)
async def document_delete(
    request: Request,
    doc_id: Annotated[int, Path(description='文档主键')],
    query_db: Annotated[AsyncSession, DBSessionDependency()],
) -> Response:
    await DocumentService.delete_document(query_db, doc_id)
    return ResponseUtil.success()


@document_controller.post(
    '/batch-delete',
    summary='批量删除文档接口',
    description='逐个级联删除；部分失败返回结果清单',
    response_model=DataResponseModel,
    dependencies=[UserInterfaceAuthDependency('agent:knowledge:document:delete')],
)
@ApiCacheEvict(namespaces=ApiGroup.KNOWLEDGE_MUTATION)
@Log(title='知识库文档', business_type=BusinessType.DELETE)
async def document_batch_delete(
    request: Request,
    data: DocumentBatchDeleteModel,
    query_db: Annotated[AsyncSession, DBSessionDependency()],
) -> Response:
    result = await DocumentService.batch_delete_documents(query_db, data.doc_ids)
    return ResponseUtil.success(data=result)
